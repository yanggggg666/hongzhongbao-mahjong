{
  "expo": {
    "name": "红中宝麻将",
    "slug": "hongzhongbao-mahjong",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.hongzhongbao.mahjong",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "用于在局域网内发现好友并联机游戏",
        "NSBonjourServices": ["_hongzhongbao._tcp"],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.hongzhongbao.mahjong",
      "screenOrientation": "landscape",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b5e20",
          "dark": {
            "backgroundColor": "#0d3311"
          }
        }
      ]
    ]
  }
}
